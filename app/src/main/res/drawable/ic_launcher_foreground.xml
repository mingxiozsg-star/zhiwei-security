            <gradient android:type="linear" android:startX="24" android:startY="18" android:endX="84" android:endY="98">
                <item android:offset="0" android:color="#FF8FB8"/>
                <item android:offset="0.5" android:color="#FF6B9D"/>
                <item android:offset="1" android:color="#7EC8E3"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左耳内衬（粉） -->
    <path android:fillColor="#55FF6B9D" android:pathData="M31.5,23 L39,28.5 L32.5,33 Z" />
    <!-- 右耳内衬（冰蓝） -->
    <path android:fillColor="#557EC8E3" android:pathData="M76.5,23 L69,28.5 L75.5,33 Z" />

    <!-- 内部高光层 -->
    <path
        android:fillColor="#14FF8FB8"
        android:pathData="M54,36 L77,45 L77,58 C77,73 67,85 54,91 C41,85 31,73 31,58 L31,45 Z" />

