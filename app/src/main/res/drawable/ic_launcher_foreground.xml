    <!-- 背景光晕：粉色径向渐变 -->
    <path android:pathData="M54,54 m-30,0 a30,30 0 1,1 60,0 a30,30 0 1,1 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="34">
                <item android:offset="0" android:color="#33FF6B9D"/>
                <item android:offset="1" android:color="#00FF6B9D"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 猫耳盾牌主体：深色纵向渐变（顶部两侧尖耳 + 盾牌下身） -->
    <path android:pathData="M30,18 L42,26 L54,30 L66,26 L78,18 L80,32 L84,38 L84,58 C84,77 71,91 54,98 C37,91 24,77 24,58 L24,38 L28,32 Z">
