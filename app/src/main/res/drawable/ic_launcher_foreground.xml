                <item android:offset="0" android:color="#2E2E4A"/>
                <item android:offset="1" android:color="#14142A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 猫耳盾牌描边：粉→冰蓝线性渐变 -->
    <path
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M30,18 L42,26 L54,30 L66,26 L78,18 L80,32 L84,38 L84,58 C84,77 71,91 54,98 C37,91 24,77 24,58 L24,38 L28,32 Z">
