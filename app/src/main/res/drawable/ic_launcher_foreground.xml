<?xml version="1.0" encoding="utf-8"?>
<!--
  知微安全 图标（v1.7.0 重制）
  设计：小体量紧凑盾牌（占画布 56dp，标准自适应图标安全区 66dp 内），
  蓝色系立体渐变 + 顶部高光 + 极简细勾，去掉旧版过大的占比与厚重描边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景柔光（很淡，只托一层空气感） -->
    <path android:pathData="M54,54 m-26,0 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="52" android:gradientRadius="30">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 盾牌外轮廓：小一号，上宽下尖，肩线圆润 -->
    <path
        android:pathData="M54,32 C60.5,37.5 68,40.5 76,42 L76,56 C76,70 66.5,81 54,87 C41.5,81 32,70 32,56 L32,42 C40,40.5 47.5,37.5 54,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="32" android:startY="32" android:endX="76" android:endY="87">
                <item android:offset="0" android:color="#5B8CFF" />
                <item android:offset="0.55" android:color="#3568E8" />
                <item android:offset="1" android:color="#1B3FA6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 内层亮面：制造厚度，边缘留 3dp 蓝边 -->
    <path
        android:pathData="M54,37.5 C59.5,42 66,44.6 72.5,46 L72.5,56 C72.5,67 64.5,76.5 54,81.5 C43.5,76.5 35.5,67 35.5,56 L35.5,46 C42,44.6 48.5,42 54,37.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="35.5" android:startY="37.5" android:endX="72.5" android:endY="81.5">
                <item android:offset="0" android:color="#8AAEFF" />
                <item android:offset="1" android:color="#2A55C8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶部玻璃高光 -->
    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M54,37.5 C59.5,42 66,44.6 72.5,46 L72.5,51 C66,49.6 59.5,47 54,42.5 C48.5,47 42,49.6 35.5,51 L35.5,46 C42,44.6 48.5,42 54,37.5 Z" />

    <!-- 安全勾：细笔圆头，紧凑居中 -->
    <path
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:pathData="M45.5,58.5 L52,65 L64,48.5" />

    <!-- 勾下短基线：增强"已验证"的精致感 -->
    <path
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeColor="#66FFFFFF"
        android:pathData="M46,72 L62,72" />
</vector>