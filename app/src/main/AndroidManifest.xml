<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Shizuku -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 内置 Dhizuku 服务端 API 权限（第三方客户端需声明） -->
    <permission
        android:name="com.zhiwei.security.permission.API"
        android:label="使用知微特权服务"
        android:protectionLevel="normal" />

    <!-- 安装下载的更新包 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ZhiweiApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 防锁机守护前台服务 -->
        <service
            android:name=".service.ProtectService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="防锁机守护，监控可疑锁机行为并拦截" />
        </service>

        <!-- 守护进程服务（独立 :guard 进程互守） -->
        <service
            android:name=".service.GuardService"
            android:enabled="true"
            android:exported="false"
            android:process=":guard"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="守护进程，与主服务互相监视，防止被杀" />
        </service>

        <!-- 守护进程 2/3（三进程互守） -->
        <service
            android:name=".service.GuardService2"
            android:enabled="true"
            android:exported="false"
            android:process=":guard2"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="守护进程2，多进程互守" />
        </service>
        <service
            android:name=".service.GuardService3"
            android:enabled="true"
            android:exported="false"
            android:process=":guard3"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="守护进程3，多进程互守" />
        </service>

        <!-- 无障碍守护（独立 :volguard 进程，系统托管，主进程被杀自动拉起） -->
        <service
            android:name=".service.ZhiweiAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":volguard">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/zhiwei_accessibility" />
        </service>

        <!-- 后台网络拦截（VPN 黑洞，独立 :netguard 进程） -->
        <service
            android:name=".service.NetGuardService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process=":netguard">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- 开机自启 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 定时保活 -->
        <receiver
            android:name=".service.KeepAliveReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 知微特权服务（对第三方应用开放，Shizuku 式授权架构） -->
        <service
            android:name=".service.ZhiweiApiService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.zhiwei.security.api.BIND" />
            </intent-filter>
        </service>

        <!-- 特权服务发现入口（第三方应用 contentResolver.call 拿 Binder） -->
        <provider
            android:name=".provider.ZhiweiProvider"
            android:authorities="com.zhiwei.security.provider"
            android:enabled="true"
            android:exported="true" />

        <!-- 内置 Shizuku 客户端 API：接收 server 下发的 Binder（官方协议，原封搬入） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.zhiwei.security.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- 第三方授权申请弹窗 -->
        <activity
            android:name=".ui.AuthGrantActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 危险命令拦截弹窗 -->
        <activity
            android:name=".ui.CommandConfirmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 内置 Dhizuku 服务端：Provider（官方协议发现机制） -->
        <provider
            android:name=".dhizuku.ZhiweiDhizukuProvider"
            android:authorities="com.zhiwei.security.dhizuku_server.provider"
            android:enabled="true"
            android:exported="true"
            android:permission="com.zhiwei.security.permission.API" />

        <!-- 内置 Dhizuku 服务端：设备所有者接收器 -->
        <receiver
            android:name=".dhizuku.ZhiweiDAReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/zhiwei_device_admin" />
        </receiver>

        <!-- 内置 Dhizuku 服务端：授权申请页（官方协议 activity） -->
        <activity
            android:name=".ui.DhizukuGrantActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.zhiwei.security.action.REQUEST_DHIZUKU_PERMISSION" />
            </intent-filter>
        </activity>

        <!-- 更新包安装 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.zhiwei.security.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 病毒警告 -->
        <activity
            android:name=".ui.ShieldWarnActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>